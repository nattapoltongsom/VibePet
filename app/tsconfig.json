{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "rootDir": "src",
    "outDir": "dist-js",
    "sourceMap": false
  },
  "include": [
    "src/shared/**/*.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts"
  ]
}
