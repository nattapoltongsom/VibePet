{
  "name": "vibepet",
  "version": "2.0.0",
  "description": "VibePet — Free open-source macOS floating AI companion (TypeScript + Electron) that shows live agent thoughts, active model, coding progress, and approval alerts.",
  "main": "dist-js/main/index.js",
  "author": "VibePet Contributors",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit && tsc -p ../integrations/tsconfig.json --noEmit",
    "compile": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json && tsc -p ../integrations/tsconfig.json && node scripts/copy-assets.mjs",
    "start": "npm run compile && electron .",
    "generate:icon": "node scripts/generate-icon.mjs",
    "build:mac": "npm run compile && electron-builder --mac",
    "build:mac:dir": "npm run compile && electron-builder --mac dir"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.15.3",
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3"
  },
  "build": {
    "appId": "com.vibepet.app",
    "productName": "VibePet",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "dist-js/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../integrations/dist",
        "to": "integrations",
        "filter": [
          "**/*.mjs"
        ]
      },
      {
        "from": "../skills/pet-companion/SKILL.md",
        "to": "skills/pet-companion/SKILL.md"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "VibePet",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
