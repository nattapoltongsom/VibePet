{
  "compilerOptions": {
    "target": "ES2022",
    "module": "None",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "src/renderer",
    "outDir": "dist-js/renderer",
    "sourceMap": false
  },
  "include": [
    "src/renderer/**/*.ts"
  ]
}
